; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="GameDev.tv UI Course Project"
config/description="The base project for GameDev.tv's Godot UI course!"
config/version="1.0.0"
run/main_scene="uid://dem0toly15n4e"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="uid://bp10llfivxdx0"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="GameDev.tv UI Course Project"

[file_customization]

folder_colors={
"res://Assets/": "green",
"res://Scenes/": "blue",
"res://StyleBoxes/": "pink"
}

[input]

pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194305,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
